# Copy file này thành .env.local rồi điền API key của bạn:

# 1. Gemini API Key (bắt buộc để viết biên bản cuộc họp có cấu trúc)
# Lấy miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq API Key (cần khi dùng Ghi âm trực tiếp hoặc Tải file âm thanh để Whisper chép lời)
# Lấy tại: https://console.groq.com/keys
GROQ_API_KEY=

# Tuỳ chọn đổi model & cấu hình suy nghĩ giống Taskflow:
# RECAP_SUMMARY_MODEL=gemini-2.5-flash
# RECAP_TRANSCRIBE_MODEL=whisper-large-v3
# RECAP_SUMMARY_THINKING=medium
# RECAP_SUMMARY_MAX_OUTPUT_TOKENS=24576
